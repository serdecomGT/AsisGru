@page "/asistencia"
@using AsisGru.Models
@using AsisGru.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@inject AsistenciaService AsistenciaService
@inject ActividadService ActividadService
@inject ParticipanteService ParticipanteService

<PageTitle>AsisGru | Registro de asistencia</PageTitle>

<section class="page-header">
    <div><span class="eyebrow">MÓDULO 5</span><h1>Registro de asistencia</h1><p>Selecciona una actividad y marca los participantes que asistieron.</p></div>
</section>

<div class="form-card">
    <div class="field">
        <label>Actividad</label>
        <select class="input" @bind="actividadId" @bind:after="CargarAsistencia">
            <option value="0">Selecciona una actividad</option>
            @foreach (var a in actividades.Where(x => x.Activo))
            {
                <option value="@a.Id">@a.Nombre — @a.Fecha</option>
            }
        </select>
    </div>
</div>

@if (actividadSeleccionada is not null)
{
    <div class="attendance-header">
        <div><h2>@actividadSeleccionada.Nombre</h2><p>@actividadSeleccionada.Fecha @(actividadSeleccionada.Hora is null ? "" : $"· {actividadSeleccionada.Hora}")</p></div>
        <span class="badge badge-success">@seleccionados.Count(x => x.Value) presentes</span>
    </div>

    <div class="attendance-list">
        @foreach (var p in participantes)
        {
            <label class="attendance-row">
                <div><strong>@p.NombreCompleto</strong><small>@p.Telefono</small></div>
                <input type="checkbox" checked="@seleccionados.GetValueOrDefault(p.Id)" @onchange="e => Cambiar(p.Id, e)" />
            </label>
        }
    </div>

    <div class="form-actions">
        <button class="btn btn-primary" @onclick="GuardarAsistencia">Guardar asistencia</button>
    </div>

    @if (!string.IsNullOrEmpty(mensaje)) { <div class="alert alert-success">@mensaje</div> }
}

@code {
    private List<Actividad> actividades = [];
    private List<Participante> participantes = [];
    private Dictionary<int, bool> seleccionados = [];
    private int actividadId;
    private Actividad? actividadSeleccionada;
    private string? mensaje;

    protected override async Task OnInitializedAsync()
    {
        actividades = await ActividadService.ObtenerTodosAsync();
        participantes = await ParticipanteService.ObtenerTodosAsync(false);
    }

    private async Task CargarAsistencia()
    {
        actividadSeleccionada = actividades.FirstOrDefault(x => x.Id == actividadId);
        seleccionados = [];
        mensaje = null;
        if (actividadSeleccionada is null) return;

        var existentes = await AsistenciaService.ObtenerPorActividadAsync(actividadId);
        foreach (var p in participantes)
            seleccionados[p.Id] = existentes.Any(x => x.ParticipanteId == p.Id);
    }

    private void Cambiar(int id, ChangeEventArgs e)
    {
        seleccionados[id] = e.Value is bool value && value;
    }

    private async Task GuardarAsistencia()
    {
        foreach (var p in participantes)
        {
            var marcado = seleccionados.GetValueOrDefault(p.Id);
            var registrado = await AsistenciaService.EstaRegistradaAsync(p.Id, actividadId);

            if (marcado && !registrado) await AsistenciaService.RegistrarAsync(p.Id, actividadId);
            if (!marcado && registrado) await AsistenciaService.QuitarAsync(p.Id, actividadId);
        }

        mensaje = "La asistencia se guardó correctamente. No se permiten duplicados para la misma actividad.";
    }
}

