@page "/actividades"
@using AsisGru.Models
@using AsisGru.Services
@inject CategoriaService CategoriaService
@inject GrupoService GrupoService
@inject ActividadService ActividadService


<PageTitle>AsisGru | Actividades</PageTitle>

<section class="page-header">
    <div><span class="eyebrow">MÓDULO 4</span><h1>Actividades</h1><p>Crea y administra las actividades del grupo.</p></div>
    <button class="btn btn-primary" @onclick="Nuevo">+ Nueva actividad</button>
</section>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-error">@error</div>
}

@if (formulario)
{
    <div class="form-card">
        <div class="section-title"><span>+</span> @(modelo.Id == 0 ? "Nueva actividad" : "Editar actividad")</div>
        <div class="form-grid">
            <div class="field"><label>Nombre *</label><input class="input" @bind="modelo.Nombre" /></div>
            <div class="field">
                <label>Categoría *</label>
                <select class="input" @bind="modelo.CategoriaId">
                    <option value="0">Selecciona una categoría</option>
                    @foreach (var c in categorias.Where(x => x.Activo))
                    {
                        <option value="@c.Id">@c.Nombre</option>
                    }
                </select>
            </div>
            <div class="field full"><label>Descripción</label><textarea class="input" @bind="modelo.Descripcion"></textarea></div>
            <input class="input" type="date"
                   value="@modelo.Fecha"
                   @onchange="e => modelo.Fecha = e.Value?.ToString() ?? string.Empty" />
            <input class="input" type="time"
                   value="@modelo.Hora"
                   @onchange="e => modelo.Hora = e.Value?.ToString()" />
        </div>
        <div class="form-actions"><button class="btn btn-primary" @onclick="Guardar">Guardar</button><button class="btn btn-secondary" @onclick="Cancelar">Cancelar</button></div>
    </div>
}

<div class="table-card">
    <div class="table-header"><strong>Actividades registradas</strong><span>@actividades.Count</span></div>
    <div class="table-scroll">
        <table>
            <thead><tr><th>Actividad</th><th>Categoría</th><th>Fecha</th><th>Hora</th><th>Estado</th><th>Acciones</th></tr></thead>
            <tbody>
                @foreach (var a in actividades)
                {
                    <tr>
                        <td><strong>@a.Nombre</strong><br /><small>@a.Descripcion</small></td>
                        <td>@NombreCategoria(a.CategoriaId)</td>
                        <td>@a.Fecha</td>
                        <td>@(string.IsNullOrWhiteSpace(a.Hora) ? "—" : a.Hora)</td>
                        <td><span class="badge @(a.Activo ? "badge-success" : "badge-muted")">@(a.Activo ? "Activa" : "Inactiva")</span></td>
                        <td><button class="link-button" @onclick="() => Editar(a)">Editar</button></td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!actividades.Any())
        {
            <div class="empty-state"><h3>No hay actividades</h3><p>Crea una actividad para comenzar a registrar asistencias.</p></div>
        }
    </div>
</div>

@code {
    private List<Actividad> actividades = [];
    private List<CategoriaActividad> categorias = [];
    private Actividad modelo = new();
    private bool formulario;
    private string? error;

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        actividades = await ActividadService.ObtenerTodosAsync();
        categorias = await CategoriaService.ObtenerTodosAsync();
    }

    private string NombreCategoria(int id) => categorias.FirstOrDefault(x => x.Id == id)?.Nombre ?? "Sin categoría";

    private void Nuevo()
    {
        modelo = new Actividad { Fecha = DateTime.Today.ToString("yyyy-MM-dd"), Activo = true };
        error = null; formulario = true;
    }

    private void Editar(Actividad a)
    {
        modelo = new Actividad { Id = a.Id, Nombre = a.Nombre, Descripcion = a.Descripcion, Fecha = a.Fecha, Hora = a.Hora, CategoriaId = a.CategoriaId, GrupoId = a.GrupoId, Activo = a.Activo };
        error = null; formulario = true;
    }

    private async Task Guardar()
    {
        if (string.IsNullOrWhiteSpace(modelo.Nombre) || modelo.CategoriaId == 0 || string.IsNullOrWhiteSpace(modelo.Fecha))
        { error = "Nombre, categoría y fecha son obligatorios."; return; }

        var grupo = await GrupoService.ObtenerAsync();
        if (grupo is null) { error = "Primero configura el grupo."; return; }

        modelo.GrupoId = grupo.Id;
        await ActividadService.GuardarAsync(modelo);
        formulario = false;
        await Cargar();
    }

    private void Cancelar() => formulario = false;
}
