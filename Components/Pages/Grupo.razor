@page "/grupo"
@using AsisGru.Models
@using AsisGru.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@inject GrupoService GrupoService

<PageTitle>AsisGru | Configuración del grupo</PageTitle>

<section class="page-header">
    <div>
        <span class="eyebrow">MÓDULO 1</span>
        <h1>Configuración del grupo</h1>
        <p>Registra los datos generales y el responsable del grupo.</p>
    </div>
</section>

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert @(error ? "alert-error" : "alert-success")">
        @mensaje
    </div>
}

@if (!grupoGuardado || editando)
{
    <EditForm Model="@grupo" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />

        <div class="form-card">

            <div class="section-title">
                <span>01</span> Datos generales
            </div>

            <div class="form-grid">

                <div class="field full">
                    <label>Nombre del grupo *</label>
                    <InputText class="input"
                               @bind-Value="grupo.Nombre" />
                    <ValidationMessage For="@(() => grupo.Nombre)" />
                </div>

                <div class="field full">
                    <label>Descripción</label>
                    <InputTextArea class="input"
                                   @bind-Value="grupo.Descripcion" />
                </div>

                <div class="field">
                    <label>Responsable *</label>
                    <InputText class="input"
                               @bind-Value="grupo.Responsable" />
                    <ValidationMessage For="@(() => grupo.Responsable)" />
                </div>

                <div class="field">
                    <label>Teléfono del responsable *</label>
                    <InputText class="input"
                               @bind-Value="grupo.TelefonoResponsable" />
                    <ValidationMessage For="@(() => grupo.TelefonoResponsable)" />
                </div>

                <div class="field full">
                    <label>Organización</label>
                    <InputText class="input"
                               @bind-Value="grupo.Organizacion" />
                </div>

            </div>

            <div class="form-actions">
                <button class="btn btn-primary" type="submit">
                    Guardar configuración
                </button>

                @if (editando)
                {
                    <button class="btn btn-secondary"
                            type="button"
                            @onclick="CancelarEdicion">
                        Cancelar
                    </button>
                }
            </div>

        </div>
    </EditForm>
}

<!-- INFORMACIÓN GUARDADA -->
<div class="table-card">

    <div class="table-header">
        <strong>Información del grupo</strong>

        @if (grupoGuardado)
        {
            <span>Configuración guardada</span>
        }
        else
        {
            <span>Sin configuración</span>
        }
    </div>

    @if (grupoGuardado && !editando)
    {
        <div class="form-grid">

            <div class="field">
                <label>Nombre del grupo</label>
                <div class="input">
                    @grupo.Nombre
                </div>
            </div>

            <div class="field">
                <label>Responsable</label>
                <div class="input">
                    @grupo.Responsable
                </div>
            </div>

            <div class="field">
                <label>Teléfono del responsable</label>
                <div class="input">
                    @grupo.TelefonoResponsable
                </div>
            </div>

            <div class="field">
                <label>Organización</label>
                <div class="input">
                    @(string.IsNullOrWhiteSpace(grupo.Organizacion)
                        ? "No especificada"
                        : grupo.Organizacion)
                </div>
            </div>

            <div class="field full">
                <label>Descripción</label>
                <div class="input">
                    @(string.IsNullOrWhiteSpace(grupo.Descripcion)
                        ? "Sin descripción."
                        : grupo.Descripcion)
                </div>
            </div>

        </div>

        <div class="form-actions">
            <button class="btn btn-primary"
                    @onclick="EditarConfiguracion">
                Editar configuración
            </button>
        </div>
    }
    else if (!grupoGuardado)
    {
        <div class="empty-state">
            <h3>No hay información registrada</h3>
            <p>
                Ingresa los datos del grupo en el formulario
                y presiona "Guardar configuración".
            </p>
        </div>
    }

</div>

@code {

    private MGrupo grupo = new();

    private string? mensaje;
    private bool error;
    private bool grupoGuardado;
    private bool editando;

    protected override async Task OnInitializedAsync()
    {
        var grupoExistente = await GrupoService.ObtenerAsync();

        if (grupoExistente is not null)
        {
            grupo = grupoExistente;
            grupoGuardado = true;
            editando = false;
        }
    }

    private async Task Guardar()
    {
        if (string.IsNullOrWhiteSpace(grupo.Nombre) ||
            string.IsNullOrWhiteSpace(grupo.Responsable) ||
            string.IsNullOrWhiteSpace(grupo.TelefonoResponsable))
        {
            error = true;
            mensaje = "Completa los campos obligatorios.";
            return;
        }

        grupo.Nombre = grupo.Nombre.Trim();
        grupo.Responsable = grupo.Responsable.Trim();
        grupo.TelefonoResponsable = grupo.TelefonoResponsable.Trim();

        if (!string.IsNullOrWhiteSpace(grupo.Descripcion))
        {
            grupo.Descripcion = grupo.Descripcion.Trim();
        }

        if (!string.IsNullOrWhiteSpace(grupo.Organizacion))
        {
            grupo.Organizacion = grupo.Organizacion.Trim();
        }

        await GrupoService.GuardarAsync(grupo);

        grupoGuardado = true;
        editando = false;

        error = false;
        mensaje = "La configuración del grupo se guardó correctamente.";
    }

    private void EditarConfiguracion()
    {
        editando = true;
        mensaje = null;
        error = false;
    }

    private void CancelarEdicion()
    {
        editando = false;
        mensaje = null;
        error = false;
    }
}